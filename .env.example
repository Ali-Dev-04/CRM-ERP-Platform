# ──────────────────────────────────────────────────────────────
# Runtime environment (copy to .env and fill in real values)
# Never commit a real .env. All values are validated at boot (zod).
# ──────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_erp?schema=public

# Redis (cache + BullMQ queues)
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long-xxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long-xxxxx
JWT_ACCESS_TTL=900          # 15 minutes (seconds)
JWT_REFRESH_TTL=2592000     # 30 days (seconds)
PASSWORD_MIN_LENGTH=12

# CORS
CORS_ORIGINS=http://localhost:3000

# S3-compatible object storage (File Management module)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crm-erp-files
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345

# AI gateway (M6) — OpenAI-compatible endpoint
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Rate limiting (per-IP token bucket)
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
